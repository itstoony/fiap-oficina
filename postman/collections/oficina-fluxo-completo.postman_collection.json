{
  "info": {
    "name": "Oficina Mecânica — Fluxo Completo",
    "_postman_id": "oficina-fluxo-completo-v1",
    "description": "Cobertura completa dos 3 fluxos do Miro (Criação da OS, Acompanhamento da OS, Gestão de Peças) e Event Storming.\n\n▶️ COMO USAR:\n1. Execute '0.1 Login' — o token JWT é salvo automaticamente\n2. Execute o Setup completo (pastas 1 e 2)\n3. Siga os fluxos na ordem das pastas\n\nVariáveis capturadas automaticamente via test scripts: token, servicoId, servico2Id, pecaId, peca2Id, atendenteId, clienteId, veiculoId, osId, osNumero, itemServicoId, itemPecaId",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "servicoId", "value": "", "type": "string" },
    { "key": "servico2Id", "value": "", "type": "string" },
    { "key": "pecaId", "value": "", "type": "string" },
    { "key": "peca2Id", "value": "", "type": "string" },
    { "key": "atendenteId", "value": "", "type": "string" },
    { "key": "clienteId", "value": "", "type": "string" },
    { "key": "veiculoId", "value": "", "type": "string" },
    { "key": "osId", "value": "", "type": "string" },
    { "key": "osNumero", "value": "", "type": "string" },
    { "key": "itemServicoId", "value": "", "type": "string" },
    { "key": "itemPecaId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Autenticação",
      "item": [
        {
          "name": "0.1 Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('✅ Token JWT salvo');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "1. Setup — Catálogo de Serviços e Peças",
      "item": [
        {
          "name": "1.1 Criar Serviço: Troca de Óleo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('servicoId', pm.response.json().id);",
                  "    console.log('✅ servicoId salvo:', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Troca de Óleo\",\n  \"descricao\": \"Troca de óleo do motor e substituição do filtro de óleo\",\n  \"precoBase\": 120.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/servicos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "servicos"] }
          }
        },
        {
          "name": "1.2 Criar Serviço: Alinhamento e Balanceamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('servico2Id', pm.response.json().id);",
                  "    console.log('✅ servico2Id salvo:', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Alinhamento e Balanceamento\",\n  \"descricao\": \"Alinhamento das rodas dianteiras e traseiras com balanceamento\",\n  \"precoBase\": 85.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/servicos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "servicos"] }
          }
        },
        {
          "name": "1.3 Listar Serviços",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/servicos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "servicos"] }
          }
        },
        {
          "name": "1.4 Criar Peça: Filtro de Óleo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('pecaId', pm.response.json().id);",
                  "    console.log('✅ pecaId salvo:', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filtro de Óleo\",\n  \"codigo\": \"FILTRO-001\",\n  \"precoUnitario\": 35.90,\n  \"qtdEstoque\": 0,\n  \"qtdMinima\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/pecas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas"] }
          }
        },
        {
          "name": "1.5 Criar Peça: Óleo Motor 5W30",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('peca2Id', pm.response.json().id);",
                  "    console.log('✅ peca2Id salvo:', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Óleo Motor 5W30\",\n  \"codigo\": \"OLEO-5W30\",\n  \"precoUnitario\": 28.50,\n  \"qtdEstoque\": 0,\n  \"qtdMinima\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/pecas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas"] }
          }
        },
        {
          "name": "1.6 Entrada de Estoque — Filtro de Óleo (10 unidades)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 10,\n  \"observacao\": \"Compra inicial de estoque\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/pecas/{{pecaId}}/entrada", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas", "{{pecaId}}", "entrada"] }
          }
        },
        {
          "name": "1.7 Entrada de Estoque — Óleo Motor 5W30 (20 unidades)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 20,\n  \"observacao\": \"Compra inicial de estoque\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/pecas/{{peca2Id}}/entrada", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas", "{{peca2Id}}", "entrada"] }
          }
        },
        {
          "name": "1.8 Listar Peças",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/pecas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas"] }
          }
        },
        {
          "name": "1.9 Verificar Peças com Estoque Crítico",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/pecas/criticas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas", "criticas"] }
          }
        }
      ]
    },
    {
      "name": "2. Setup — Atendente",
      "description": "Gestão de atendentes. Necessário para o passo 'Atribuir mecânico' do Fluxo 2.",
      "item": [
        {
          "name": "2.1 Cadastrar Atendente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('atendenteId', pm.response.json().id);",
                  "    console.log('✅ atendenteId salvo:', pm.response.json().id);",
                  "} else {",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Carlos Mecânico\",\n  \"email\": \"carlos@oficina.com\",\n  \"telefone\": \"11988887777\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/atendentes", "host": ["{{baseUrl}}"], "path": ["api", "admin", "atendentes"] }
          }
        },
        {
          "name": "2.2 Listar Atendentes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/atendentes", "host": ["{{baseUrl}}"], "path": ["api", "admin", "atendentes"] }
          }
        },
        {
          "name": "2.3 Buscar Atendente por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/atendentes/{{atendenteId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "atendentes", "{{atendenteId}}"] }
          }
        },
        {
          "name": "2.4 Atualizar Atendente",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Carlos da Silva\",\n  \"email\": \"carlos@oficina.com\",\n  \"telefone\": \"11988887777\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/atendentes/{{atendenteId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "atendentes", "{{atendenteId}}"] }
          }
        },
        {
          "name": "2.5 Excluir Atendente",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/admin/atendentes/{{atendenteId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "atendentes", "{{atendenteId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Fluxo 1 — Criação da OS",
      "description": "Fluxo completo de identificação do cliente, cadastro do veículo e abertura da Ordem de Serviço com serviços e peças. Termina com status AGUARDANDO_APROVACAO.",
      "item": [
        {
          "name": "3.1 Buscar Cliente por CPF/CNPJ (cliente já cadastrado?)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/clientes/documento/529.982.247-25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "clientes", "documento", "529.982.247-25"]
            }
          }
        },
        {
          "name": "3.2 Cadastrar Cliente (CPF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('clienteId', pm.response.json().id);",
                  "    console.log('✅ clienteId salvo:', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@email.com\",\n  \"telefone\": \"11999999999\",\n  \"documento\": \"529.982.247-25\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/clientes", "host": ["{{baseUrl}}"], "path": ["api", "admin", "clientes"] }
          }
        },
        {
          "name": "3.3 Buscar Veículo por Placa (veículo já cadastrado?)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/veiculos/placa/ABC1234", "host": ["{{baseUrl}}"], "path": ["api", "admin", "veiculos", "placa", "ABC1234"] }
          }
        },
        {
          "name": "3.4 Cadastrar Veículo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('veiculoId', pm.response.json().id);",
                  "    console.log('✅ veiculoId salvo:', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"ano\": 2020,\n  \"cor\": \"Prata\",\n  \"placa\": \"ABC-1234\",\n  \"clienteId\": \"{{clienteId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/veiculos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "veiculos"] }
          }
        },
        {
          "name": "3.5 Listar Veículos do Cliente",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/veiculos/cliente/{{clienteId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "veiculos", "cliente", "{{clienteId}}"] }
          }
        },
        {
          "name": "3.6 Abrir OS (RECEBIDA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('osId', json.id);",
                  "    pm.collectionVariables.set('osNumero', json.numero);",
                  "    console.log('✅ osId salvo:', json.id);",
                  "    console.log('✅ osNumero salvo:', json.numero);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"atendenteId\": null,\n  \"observacoes\": \"Cliente relata barulho no motor e consumo excessivo de óleo\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/ordens", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens"] }
          }
        },
        {
          "name": "3.7 Adicionar Serviço à OS (Troca de Óleo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const itens = pm.response.json().itensServico;",
                  "    if (itens && itens.length > 0) {",
                  "        pm.collectionVariables.set('itemServicoId', itens[itens.length - 1].id);",
                  "        console.log('✅ itemServicoId salvo:', itens[itens.length - 1].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"servicoId\": \"{{servicoId}}\",\n  \"quantidade\": 1,\n  \"observacao\": \"Troca completa com filtro\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/servicos", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "servicos"] }
          }
        },
        {
          "name": "3.8 Adicionar Peça à OS — Filtro de Óleo (reserva estoque)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const itens = pm.response.json().itensPeca;",
                  "    if (itens && itens.length > 0) {",
                  "        pm.collectionVariables.set('itemPecaId', itens[itens.length - 1].id);",
                  "        console.log('✅ itemPecaId salvo:', itens[itens.length - 1].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaId\": \"{{pecaId}}\",\n  \"quantidade\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/pecas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "pecas"] }
          }
        },
        {
          "name": "3.9 Adicionar Peça à OS — Óleo Motor 5W30 (reserva estoque)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaId\": \"{{peca2Id}}\",\n  \"quantidade\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/pecas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "pecas"] }
          }
        },
        {
          "name": "3.10 Ver OS com Itens e Orçamento Calculado",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}"] }
          }
        },
        {
          "name": "3.11 Iniciar Diagnóstico (RECEBIDA → EM_DIAGNOSTICO)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/iniciar-diagnostico", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "iniciar-diagnostico"] }
          }
        },
        {
          "name": "3.12 Enviar Orçamento ao Cliente (EM_DIAGNOSTICO → AGUARDANDO_APROVACAO)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/enviar-orcamento", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "enviar-orcamento"] }
          }
        }
      ]
    },
    {
      "name": "4. Fluxo 2A — Acompanhamento (Cliente Aprova)",
      "description": "Cliente consulta status da OS pelo número (endpoint público, sem JWT), aprova o orçamento. Oficina executa, finaliza e entrega o veículo.",
      "item": [
        {
          "name": "4.1 [PÚBLICO] Consultar Status da OS por Número",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/ordens/{{osNumero}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "ordens", "{{osNumero}}", "status"]
            }
          }
        },
        {
          "name": "4.2 [PÚBLICO] Cliente Aprova o Orçamento (AGUARDANDO_APROVACAO → EM_EXECUCAO)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/public/ordens/{{osNumero}}/aprovar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "ordens", "{{osNumero}}", "aprovar"]
            }
          }
        },
        {
          "name": "4.3 Ver OS após Aprovação (estoque baixado)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}"] }
          }
        },
        {
          "name": "4.4 Ver Movimentações da Peça (reserva convertida em baixa)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/pecas/{{pecaId}}/movimentacoes", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas", "{{pecaId}}", "movimentacoes"] }
          }
        },
        {
          "name": "4.5 Finalizar OS (EM_EXECUCAO → FINALIZADA)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/finalizar", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "finalizar"] }
          }
        },
        {
          "name": "4.6 [PÚBLICO] Cliente Consulta Status Final",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/ordens/{{osNumero}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "ordens", "{{osNumero}}", "status"]
            }
          }
        },
        {
          "name": "4.7 Entregar Veículo (FINALIZADA → ENTREGUE)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/entregar", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "entregar"] }
          }
        },
        {
          "name": "4.8 Ver Relatório de Tempo Médio de Execução",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/relatorios/tempo-medio", "host": ["{{baseUrl}}"], "path": ["api", "admin", "relatorios", "tempo-medio"] }
          }
        }
      ]
    },
    {
      "name": "5. Fluxo 2B — Acompanhamento (Cliente Recusa / Cancelamento)",
      "description": "Fluxo alternativo: cliente recusa o orçamento. As reservas de estoque são liberadas automaticamente.",
      "item": [
        {
          "name": "5.1 Abrir nova OS para cancelamento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('osId', json.id);",
                  "    pm.collectionVariables.set('osNumero', json.numero);",
                  "    console.log('✅ osId (cancelamento):', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\",\n  \"observacoes\": \"OS para teste de cancelamento\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/ordens", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens"] }
          }
        },
        {
          "name": "5.2 Adicionar Peça (cria reserva de estoque)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pecaId\": \"{{pecaId}}\",\n  \"quantidade\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/pecas", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "pecas"] }
          }
        },
        {
          "name": "5.3 Iniciar Diagnóstico",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/iniciar-diagnostico", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "iniciar-diagnostico"] }
          }
        },
        {
          "name": "5.4 Enviar Orçamento",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/enviar-orcamento", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "enviar-orcamento"] }
          }
        },
        {
          "name": "5.5 [PÚBLICO] Cliente Recusa o Orçamento (→ CANCELADA + libera reservas)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/public/ordens/{{osNumero}}/recusar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "ordens", "{{osNumero}}", "recusar"]
            }
          }
        },
        {
          "name": "5.6 Ver Movimentações (reserva liberada após cancelamento)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/pecas/{{pecaId}}/movimentacoes", "host": ["{{baseUrl}}"], "path": ["api", "admin", "pecas", "{{pecaId}}", "movimentacoes"] }
          }
        },
        {
          "name": "5.7 Admin Cancela OS diretamente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["// Abrir nova OS antes de cancelar diretamente pelo admin"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/admin/ordens/{{osId}}/cancelar", "host": ["{{baseUrl}}"], "path": ["api", "admin", "ordens", "{{osId}}", "cancelar"] }
          }
        }
      ]
